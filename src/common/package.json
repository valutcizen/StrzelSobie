{
  "name": "@strzel-sobie/common",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/index.models.d.ts",
      "default": "./dist/index.models.js"
    },
    "./rich-text": {
      "types": "./dist/rich-text/index.d.ts",
      "default": "./dist/rich-text/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "models": [
        "./dist/index.models.d.ts"
      ],
      "rich-text": [
        "./dist/rich-text/index.d.ts"
      ]
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc",
    "lint": "eslint . --ext .ts --fix"
  },
  "dependencies": {
    "@types/sanitize-html": "^2.16.1",
    "sanitize-html": "^2.17.4"
  }
}
