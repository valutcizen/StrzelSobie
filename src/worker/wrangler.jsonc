/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "strzel-sobie-worker",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-11",
	"observability": {
		"enabled": true
	},
	"d1_databases": [
			{
				"binding": "DB",
				"database_name": "strzel-sobie-db",
				"database_id": "strzel-sobie-db",
				"preview_database_id": "strzel-sobie-db",
				"migrations_dir": "../../migrations"
			}
	],
	"kv_namespaces": [
		{
			"binding": "SESSIONS_KV",
			"id": "${SESSIONS_KV_ID}",
			"preview_id": "${SESSIONS_KV_PREVIEW_ID}"
		}
	],
	"env": {
		"staging": {
			"name": "strzel-sobie-worker-staging",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "strzel-sobie-db-staging",
					"database_id": "${D1_DATABASE_ID_STAGING}"
				}
			],
			"kv_namespaces": [
				{
					"binding": "SESSIONS_KV",
					"id": "${SESSIONS_KV_ID_STAGING}"
				}
			]
		},
		"production": {
			"name": "strzel-sobie-worker-production",
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "strzel-sobie-db-production",
					"database_id": "${D1_DATABASE_ID_PRODUCTION}"
				}
			],
			"kv_namespaces": [
				{
					"binding": "SESSIONS_KV",
					"id": "${SESSIONS_KV_ID_PRODUCTION}"
				}
			]
		}
	}
}
