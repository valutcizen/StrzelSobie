{
  "name": "strzel-sobie",
  "private": true,
  "workspaces": [
    "src/*",
    "tests"
  ],
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build -w src/common && npm run build -w src/auth -w src/users -w src/reservations -w src/ranges -w src/notifications -w src/audit && npm run build -w src/worker",
    "build:frontend": "npm run build -w src/client",
    "dev:frontend": "npm run dev -w @strzel-sobie/client",
    "test": "vitest run",
    "test:unit": "npm run test:unit -w tests --",
    "db:migrate": "node scripts/generate-db-mock.mjs",
    "db:reset": "node scripts/generate-db-mock.mjs --regenerate",
    "dev:backend": "npm run dev -w @strzel-sobie/worker",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/bcryptjs": "^3.0.0",
    "@vitest/coverage-v8": "^4.0.6",
    "vitest": "^4.0.6"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2"
  }
}
