{
  "name": "strzel-sobie",
  "private": true,
  "type": "module",
  "workspaces": [
    "src/*",
    "tests"
  ],
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "npm run build -w src/common && npm run build -w src/auth -w src/auth-simple -w src/users -w src/reservations -w src/ranges -w src/events -w src/notifications -w src/audit && npm run build -w src/embed-map && npm run build -w src/worker",
    "build:embed": "npm run build -w src/embed-map",
    "build:frontend": "npm run build -w src/client",
    "dev:frontend": "npm run dev -w @strzel-sobie/client",
    "lint": "npm run lint --workspaces --if-present",
    "test": "vitest run",
    "test:unit": "npm run test:unit -w tests --",
    "db:migrate": "node scripts/generate-db-mock.mjs",
    "db:reset": "node scripts/generate-db-mock.mjs --regenerate",
    "db:e2e": "node scripts/generate-db-mock.mjs --no-mock-data --regenerate --file tests-e2e/e2e-mock-data.sql",
    "dev:backend": "npm run dev -w @strzel-sobie/worker",
    "dev:backend:simpleauth": "npm run dev -w @strzel-sobie/worker -- --var AUTH_MODULE:simple",
    "dev:backend:embed": "npm run build:embed && npm run dev:backend",
    "dev:embed": "concurrently \"npm:dev:backend\" \"npm:dev:embed-page\"",
    "dev:embed-page": "serve tests-dev -l 3000",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --reporter=line",
    "test:e2e-ci": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/bcryptjs": "^3.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^4.0.6",
    "concurrently": "^9.2.1",
    "eslint": "^9.8.0",
    "serve": "^14.2.5",
    "typescript": "^5.6.3",
    "vite": "^4.5.0",
    "vitest": "^4.0.6",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2"
  }
}
