-- This script creates a new user (if not exists), sets their password hash, and assigns them the
-- global "Club/Community Administrator" role (ID 6).
-- It is executed remotely via Wrangler, so leave transaction management to D1.

-- 1. Create the user record if it does not already exist.
INSERT OR IGNORE INTO users_users (email) VALUES ('__EMAIL__');

-- 2. Create or update the user's credentials using the email to find the user's ID.
--    The password hash must be generated beforehand using the application's hashing algorithm.
INSERT INTO auth_user_credentials (user_id, password_hash)
SELECT id, '__PASSWORD_HASH__' FROM users_users WHERE email = '__EMAIL__'
ON CONFLICT(user_id) DO UPDATE SET password_hash = EXCLUDED.password_hash;

-- 3. Assign the administrator role (ID 6) to the user if not already assigned.
INSERT OR IGNORE INTO users_user_global_roles (user_id, role_id)
SELECT id, 6 FROM users_users WHERE email = '__EMAIL__';
